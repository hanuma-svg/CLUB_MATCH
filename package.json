{
  "name": "clubmatch",
  "version": "1.0.0",
  "private": true,
  "description": "ClubMatch — Smart College Club & Event Recommendation Platform using Next.js, PostgreSQL, Prisma ORM, and pgvector",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup-sql": "tsx scripts/apply-sql-objects.ts",
    "db:embeddings": "tsx scripts/generate-embeddings.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "next-auth": "5.0.0-beta.25",
    "pg": "^8.15.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.5",
    "@electric-sql/pglite-socket": "^0.0.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.3",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
