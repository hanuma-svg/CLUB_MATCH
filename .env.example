# ============================================
# ClubMatch Environment Configuration
# Copy this file to .env and fill in real values
# Never commit .env to version control
# ============================================

# PostgreSQL + pgvector Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clubmatch?schema=public"

# Auth.js / NextAuth Configuration
# Generate secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-32-byte-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-32-byte-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# Semantic Embedding Provider (pgvector)
# Supported providers: "gemini" | "openai" | "ollama"
# If no API key / Ollama server is configured, semantic
# pgvector search reports unavailable and falls back
# transparently to relational interest-overlap ranking.
# ============================================
EMBEDDING_PROVIDER="gemini"
EMBEDDING_DIMENSIONS="768"

# Option 1: Google Gemini Embeddings (gemini-embedding-001 / text-embedding-004, 768 dims)
GEMINI_API_KEY=""

# Option 2: OpenAI Embeddings (text-embedding-3-small with dimensions=768)
OPENAI_API_KEY=""

# Option 3: Local Ollama Embeddings (nomic-embed-text, 768 dims)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# ============================================
# Initial Seed Accounts (Development / Academic Demo)
# Override these before production deployment
# ============================================
SEED_ADMIN_EMAIL="admin@clubmatch.pes.edu"
SEED_ADMIN_PASSWORD="Admin@ClubMatch2026!"
SEED_COORDINATOR_PASSWORD="Coord@ClubMatch2026!"
SEED_STUDENT_PASSWORD="Student@ClubMatch2026!"
